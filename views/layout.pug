doctype
html
  head
    title #{(title ? title + ' | ' : '' )} Your books

    link(rel="stylesheet" href="/public/css/bootstrap-3.3.7.min.css")
    link(rel="stylesheet" href="/public/css/bootstrap-theme-3.3.7.min.css")
    link(rel="stylesheet" href="/public/css/style.css")

    script(src="/public/js/jquery-3.1.1.min.js")
    script(src="/public/js/bootstrap-3.3.7.min.js")
    block scripts
  body
    main
      block header
        include header

      block content

    block footer
      footer(class="container")
        hr
        if env.GITHUB_REPO
          p This site is open source.&nbsp;
            a(href=env.GITHUB_REPO) Help improve this site